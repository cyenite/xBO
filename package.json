{
  "name": "xbo",
  "private": true,
  "version": "0.1.0",
  "description": "xBO: an open-source framework for building desktop-style applications for the web and Tauri.",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @xbo-ui/playground dev",
    "build:libs": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "size": "node scripts/check-size.mjs",
    "changeset": "changeset",
    "release": "pnpm build:libs && changeset publish",
    "smoke": "node scripts/smoke-scaffold.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
