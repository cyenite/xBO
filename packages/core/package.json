{
  "name": "@xbo-ui/core",
  "version": "0.1.0",
  "description": "Framework-free core of xBO: window management, geometry, shortcuts, theming and preferences for desktop-style web apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyenite/xBO.git",
    "directory": "packages/core"
  },
  "keywords": [
    "desktop",
    "window-manager",
    "ui",
    "theme",
    "oklch"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
