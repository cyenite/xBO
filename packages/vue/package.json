{
  "name": "@xbo-ui/vue",
  "version": "0.1.0",
  "description": "Vue 3 bindings for xBO: a desktop shell with windows, menus, taskbar, command palette, theming, settings and a component kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tailwind.css": "./tailwind.css"
  },
  "files": [
    "dist",
    "tailwind.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyenite/xBO.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "vue",
    "desktop",
    "window-manager",
    "ui-kit",
    "tauri",
    "design-system"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "@xbo-ui/core": "workspace:*",
    "reka-ui": "^2.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/ri": "^1.2.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/cyenite/xBO#readme",
  "bugs": {
    "url": "https://github.com/cyenite/xBO/issues"
  }
}
