{
  "name": "xbo",
  "private": true,
  "version": "0.1.0",
  "description": "xBO (Back Office): open-source FMCG ERP for web and desktop.",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @xbo/api dev",
    "dev:web": "pnpm --filter @xbo/web dev",
    "dev:desktop": "pnpm --filter @xbo/desktop dev",
    "build": "pnpm -r --filter !@xbo/desktop build",
    "build:desktop": "pnpm --filter @xbo/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
