{
  "name": "@xbo-ui/tauri",
  "version": "0.0.0",
  "description": "Tauri 2 integration for xBO: native window controls for frameless windows, settings stored in the app data directory, and opening links.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyenite/xBO.git",
    "directory": "packages/tauri"
  },
  "homepage": "https://github.com/cyenite/xBO#readme",
  "bugs": {
    "url": "https://github.com/cyenite/xBO/issues"
  },
  "keywords": [
    "tauri",
    "desktop",
    "vue",
    "xbo"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external vue --external @xbo-ui/core --external @tauri-apps/api --external @tauri-apps/plugin-store --external @tauri-apps/plugin-opener",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/plugin-opener": {
      "optional": true
    },
    "@tauri-apps/plugin-store": {
      "optional": true
    }
  },
  "dependencies": {
    "@xbo-ui/core": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
