{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xBO",
  "version": "0.1.0",
  "identifier": "org.xbo.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @xbo/web dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "pnpm --filter @xbo/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "xBO",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:3000 https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Back office for property management",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
